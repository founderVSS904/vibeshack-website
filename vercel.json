{
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/booking-hold-watchdog/",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/booking-reminders/",
      "schedule": "0 * * * *"
    }
  ],
  "outputDirectory": ".next"
}
