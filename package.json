{
  "name": "vibeshack-studios",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm test && NODE_OPTIONS=\"--max-old-space-size=4096\" next build && npm run security:client:build",
    "start": "NODE_OPTIONS=\"--max-old-space-size=2048\" next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern .next --ignore-pattern node_modules",
    "test": "tsx --import ./tests/register-css.cjs --test tests/**/*.test.ts",
    "seo:audit": "node scripts/seo-audit.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "security:audit": "npm audit --audit-level=high",
    "prebuild": "npm run security:client && node scripts/verify-employee-config.mjs && tsx scripts/verify-employee-booking.ts",
    "security:client": "node scripts/check-client-security.mjs",
    "security:client:build": "node scripts/check-client-security.mjs --require-build"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^9.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "googleapis": "^171.4.0",
    "next": "15.5.26",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.6",
    "tsx": "4.23.13",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "glob": "10.5.0",
    "js-yaml": "4.3.2",
    "postcss": "$postcss",
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=20.9 <25"
  }
}
